
{
  "name": "3d-printer-control-card",
  "version": "0.2.0",
  "description": "Advanced configurable 3D printer control card for Home Assistant",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --target=es2022 --outfile=dist/printer-control-card.js",
    "build:min": "esbuild src/index.js --bundle --format=esm --target=es2022 --minify --outfile=dist/printer-control-card.js",
    "watch": "npm run build -- --watch",
    "test": "node --test"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
